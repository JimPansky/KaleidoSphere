#!/usr/bin/env bash
set -euo pipefail
umask 077

bi_here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$bi_here"

fail() { printf >&2 'KaleidoSphere ERROR: %s\n' "$*"; exit 1; }
compose() { docker compose --file "$bi_here/compose.yaml" "$@"; }
published_port() {
  local service="$1" container_port="$2" binding
  binding="$(compose port "$service" "$container_port" | tail -n 1)"
  [ -n "$binding" ] || fail "no published port for $service:$container_port"
  printf '%s\n' "${binding##*:}"
}
require_setup() {
  [ -f "$bi_here/.env" ] || fail 'run: cp .env.example .env'
  [ -s "$bi_here/.runtime/secrets/control_token" ] || fail 'run: ./bin/bi setup'
  for secret_file in "$bi_here"/.runtime/secrets/* "$bi_here"/.secrets/*; do
    [ -e "$secret_file" ] || continue
    [ "$(stat -c '%a' "$secret_file")" = 600 ] || fail "secret file must be mode 0600: ${secret_file#$bi_here/}"
  done
}
create_secret() {
  local target="$1" kind="$2"
  [ -e "$target" ] && return 0
  case "$kind" in
    hex) openssl rand -hex 32 > "$target.tmp" ;;
    base64) openssl rand -base64 32 | tr -d '\n' > "$target.tmp"; printf '\n' >> "$target.tmp" ;;
    empty) : > "$target.tmp" ;;
    *) fail 'internal secret kind invalid' ;;
  esac
  chmod 0600 "$target.tmp"
  mv "$target.tmp" "$target"
}

case "${1:-help}" in
  setup)
    command -v docker >/dev/null || fail 'Docker is required'
    command -v openssl >/dev/null || fail 'OpenSSL is required'
    docker info >/dev/null 2>&1 || fail 'Docker daemon is unavailable'
    docker compose version >/dev/null 2>&1 || fail 'Docker Compose v2 is required'
    [ -f .env ] || fail 'copy .env.example to .env and review the selected database settings first'
    mkdir -p .runtime/secrets .runtime/metadata .runtime/projection .runtime/receipts .secrets
    chmod 0700 .runtime .runtime/secrets .runtime/metadata .runtime/projection .runtime/receipts .secrets
    create_secret .runtime/secrets/superset_secret_key hex
    create_secret .runtime/secrets/superset_admin_password base64
    create_secret .runtime/secrets/superset_analyst_password base64
    create_secret .runtime/secrets/control_token hex
    create_secret .secrets/mssql_password empty
    create_secret .secrets/oracle_password empty
    create_secret .secrets/llm_api_key empty
    chmod 0600 .runtime/secrets/* .secrets/*
    compose config --quiet
    printf 'Setup complete. Runtime secrets stay in gitignored files.\n'
    ;;
  up)
    require_setup
    compose up --detach --build --wait
    printf 'Superset: http://127.0.0.1:%s\nKaleidoSphere: http://127.0.0.1:%s\n' "$(published_port superset 8088)" "$(published_port bi-agent 18790)"
    ;;
  analyze)
    require_setup
    curl --fail --silent --show-error \
      --header 'content-type: application/json' \
      --data '{"message":"Analysiere die konfigurierte Datenbank"}' \
      "http://127.0.0.1:$(published_port bi-agent 18790)/api/chat"
    ;;
  ask)
    require_setup
    [ -n "${2:-}" ] || fail 'usage: ./bin/bi ask "Largest tables by size"'
    message="$*"
    message="${message#ask }"
    node -e 'process.stdout.write(JSON.stringify({message: process.argv[1]}))' "$message" | \
      curl --fail --silent --show-error \
        --header 'content-type: application/json' \
        --data-binary @- \
        "http://127.0.0.1:$(published_port bi-agent 18790)/api/chat"
    ;;
  search)
    require_setup
    [ -n "${2:-}" ] || fail 'usage: ./bin/bi search orders'
    message="Suche ${*:2}"
    node -e 'process.stdout.write(JSON.stringify({message: process.argv[1]}))' "$message" | \
      curl --fail --silent --show-error \
        --header 'content-type: application/json' \
        --data-binary @- \
        "http://127.0.0.1:$(published_port bi-agent 18790)/api/chat"
    ;;
  discovery)
    require_setup
    action="${2:-}"
    session_id="${3:-}"
    [ -n "$action" ] && [ -n "$session_id" ] || fail 'usage: ./bin/bi discovery {start|resume|status|answer|revise|confirm|export} session [field json-or-text]'
    case "$action" in
      start|resume|status|confirm|export)
        [ -z "${4:-}" ] || fail "usage: ./bin/bi discovery $action $session_id"
        message="Discovery $action $session_id"
        ;;
      answer|revise)
        [ -n "${4:-}" ] && [ -n "${5:-}" ] || fail "usage: ./bin/bi discovery $action $session_id field json-or-text"
        field="$4"
        value="${*:5}"
        message="Discovery $action $session_id $field $value"
        ;;
      *) fail 'discovery action must be start, resume, status, answer, revise, confirm, or export' ;;
    esac
    node -e 'process.stdout.write(JSON.stringify({message: process.argv[1]}))' "$message" | \
      curl --fail --silent --show-error \
        --header 'content-type: application/json' \
        --data-binary @- \
        "http://127.0.0.1:$(published_port bi-agent 18790)/api/chat"
    ;;
  superset-fingerprint)
    require_setup
    action="${2:-collect}"
    case "$action" in
      collect)
        mode="runtime"
        [ "${3:-}" != "--fixture" ] || mode="fixture"
        compose exec -T bi-control node -e '
          import fs from "node:fs";
          const token = fs.readFileSync("/run/secrets/control_token", "utf8").trim();
          const response = await fetch("http://127.0.0.1:18089/v1/superset/fingerprint", {
            method: "POST",
            headers: {authorization: `Bearer ${token}`, "content-type": "application/json"},
            body: JSON.stringify({action: "collect_superset_fingerprint", mode: process.argv[1]}),
          });
          const body = await response.text();
          if (!response.ok) process.stderr.write(body);
          process.exit(response.ok ? 0 : 1);
        ' "$mode"
        cat .runtime/receipts/latest-superset-fingerprint.json
        ;;
      planning-gate)
        [ -n "${3:-}" ] || fail 'usage: ./bin/bi superset-fingerprint planning-gate action-name'
        request_action="${*:3}"
        compose exec -T bi-control node -e '
          import fs from "node:fs";
          const token = fs.readFileSync("/run/secrets/control_token", "utf8").trim();
          const response = await fetch("http://127.0.0.1:18089/v1/superset/planning-gate", {
            method: "POST",
            headers: {authorization: `Bearer ${token}`, "content-type": "application/json"},
            body: JSON.stringify({action: "evaluate_superset_planning_gate", request: {action: process.argv[1]}}),
          });
          const body = await response.text();
          process.stdout.write(body);
          process.exit(response.ok ? 0 : 1);
        ' "$request_action"
        ;;
      *) fail 'usage: ./bin/bi superset-fingerprint {collect [--fixture]|planning-gate action-name}' ;;
    esac
    ;;
  promotion-bundle)
    action="${2:-}"
    shift 2 || true
    case "$action" in
      build|inspect|preflight) node services/bi-control/src/promotion-cli.mjs "$action" "$@" ;;
      *) fail 'usage: ./bin/bi promotion-bundle {build|inspect|preflight} ...' ;;
    esac
    ;;
  status)
    require_setup
    compose ps
    ;;
  logs)
    require_setup
    compose logs --tail 200 "${2:-}"
    ;;
  down)
    require_setup
    compose down --remove-orphans
    ;;
  reset)
    require_setup
    [ "${2:-}" = '--yes-i-understand' ] || fail 'reset deletes only this repo runtime state; confirm with: ./bin/bi reset --yes-i-understand'
    compose down --remove-orphans
    for directory in .runtime/metadata .runtime/projection .runtime/receipts .runtime/secrets; do
      [ -d "$directory" ] || continue
      find "$directory" -mindepth 1 -maxdepth 1 -type f -delete
    done
    printf 'Owned runtime metadata, projections, receipts, and generated internal secrets removed. Source config and external secret files retained.\n'
    ;;
  help|*)
    printf '%s\n' 'Usage: ./bin/bi {setup|up|analyze|ask "question"|search term|discovery ...|superset-fingerprint ...|promotion-bundle ...|status|logs [service]|down|reset --yes-i-understand}'
    ;;
esac
