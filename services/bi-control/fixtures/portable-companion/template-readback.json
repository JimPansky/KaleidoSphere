    "dataScopeRef": "${KS_READBACK_DATA_SCOPE_REF}",
    "objectiveRef": "${KS_READBACK_OBJECTIVE_REF}",
    "evidenceRef": "${KS_READBACK_EVIDENCE_REF}"
  },
  "secretReferences": [
