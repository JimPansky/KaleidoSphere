{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JimPansky/Superset_BI_Agent/contracts/external-api/v2/external-bi-api.schema.json",
  "title": "Superset BI Agent external API v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "action"],
  "properties": {
    "schemaVersion": { "const": "superset-bi-agent.external/intent-request/v2" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "action": { "enum": ["status", "discovery", "analyze", "plan", "preview", "readback"] },
    "input": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "action": { "enum": ["status", "analyze", "readback"] } } }, "then": { "properties": { "input": { "type": "object", "maxProperties": 0 } } } },
    { "if": { "properties": { "action": { "const": "discovery" } } }, "then": { "required": ["input"], "properties": { "input": { "type": "object", "additionalProperties": false, "required": ["command", "sessionId"], "properties": { "command": { "enum": ["start", "resume", "status", "answer", "revise", "confirm", "export"] }, "sessionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" }, "field": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$" }, "value": {} } } } } },
    { "if": { "properties": { "action": { "enum": ["plan", "preview"] } } }, "then": { "required": ["input"], "properties": { "input": { "type": "object", "additionalProperties": false, "required": ["objective"], "properties": { "objective": { "type": "string", "minLength": 3, "maxLength": 500 }, "receiptId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" } } } } } }
  ]
}
