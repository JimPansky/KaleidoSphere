{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoFe2/KaleidoSphere/contracts/portable-companion/v1/receipt-envelope.schema.json",
  "title": "KaleidoSphere Portable Companion v1 signed receipt envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "receipt",
    "bindings",
    "payloadDigest",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "kaleidosphere.portable-companion/receipt-envelope/v1" },
    "contractVersion": { "const": "1.0.0" },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "receiptId",
        "issuedAt",
        "expiresAt",
        "evidenceClass",
        "liveObservationClaim",
        "mutable",
        "claims"
      ],
      "properties": {
        "schemaVersion": { "const": "kaleidosphere.portable-companion/signed-receipt/v1" },
        "receiptId": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,96}$" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "evidenceClass": { "const": "synthetic-fixture" },
        "liveObservationClaim": { "const": false },
        "mutable": { "const": false },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observedFacts", "computedFacts", "inferredCandidates", "nonClaims"],
          "properties": {
            "observedFacts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/ObservedFact" }
            },
            "computedFacts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/ComputedFact" }
            },
            "inferredCandidates": {
              "type": "array",
              "maxItems": 4,
              "items": { "$ref": "#/$defs/InferredCandidate" }
            },
            "nonClaims": {
              "type": "array",
              "minItems": 4,
              "maxItems": 6,
              "items": { "$ref": "#/$defs/NonClaim" }
            }
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "capability", "source"],
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "schemaVersion", "schemaDigest"],
          "properties": {
            "id": { "const": "kaleidosphere.portable-companion" },
            "version": { "const": "1.0.0" },
            "schemaVersion": { "const": "kaleidosphere.portable-companion/contract/v1" },
            "schemaDigest": { "$ref": "#/$defs/Sha256Digest" }
          }
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractId", "contractVersion", "capabilityId", "runtimeIntent", "manifestDigest"],
          "properties": {
            "contractId": { "const": "superset-bi-agent.external" },
            "contractVersion": { "const": "2.0.0" },
            "capabilityId": { "const": "bi.readback.read" },
            "runtimeIntent": { "const": "readback" },
            "manifestDigest": { "$ref": "#/$defs/Sha256Digest" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "sourceMapSchemaVersion", "sourceCommit", "fixtureClass"],
          "properties": {
            "repository": { "const": "JoFe2/KaleidoSphere" },
            "sourceMapSchemaVersion": { "const": "chimpmaera.bi/source-map/v2" },
            "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "fixtureClass": { "const": "synthetic-only" }
          }
        }
      }
    },
    "payloadDigest": { "$ref": "#/$defs/Sha256Digest" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "encoding", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "encoding": { "const": "base64url" },
        "keyId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,80}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  },
  "$defs": {
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ClaimBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claimClass", "statement"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,80}$" },
        "claimClass": {
          "enum": ["observed-fact", "computed-fact", "inferred-candidate", "non-claim"]
        },
        "statement": { "type": "string", "minLength": 3, "maxLength": 200 }
      }
    },
    "ObservedFact": {
      "allOf": [
        { "$ref": "#/$defs/ClaimBase" },
        { "properties": { "claimClass": { "const": "observed-fact" } } }
      ]
    },
    "ComputedFact": {
      "allOf": [
        { "$ref": "#/$defs/ClaimBase" },
        { "properties": { "claimClass": { "const": "computed-fact" } } }
      ]
    },
    "InferredCandidate": {
      "allOf": [
        { "$ref": "#/$defs/ClaimBase" },
        { "properties": { "claimClass": { "const": "inferred-candidate" } } }
      ]
    },
    "NonClaim": {
      "allOf": [
        { "$ref": "#/$defs/ClaimBase" },
        { "properties": { "claimClass": { "const": "non-claim" } } }
      ]
    }
  }
}
