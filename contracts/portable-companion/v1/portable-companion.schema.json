{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoFe2/KaleidoSphere/contracts/portable-companion/v1/portable-companion.schema.json",
  "title": "KaleidoSphere Portable Companion v1 contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "externalApiV2",
    "utilityActions",
    "boundaries",
    "claimClasses",
    "compatibility",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": "kaleidosphere.portable-companion/contract/v1" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "stability", "authority"],
      "properties": {
        "id": { "const": "kaleidosphere.portable-companion" },
        "version": { "const": "1.0.0" },
        "stability": { "const": "foundation" },
        "authority": { "const": "offline-utility-only" }
      }
    },
    "externalApiV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "contractVersion", "runtimeIntents"],
      "properties": {
        "contractId": { "const": "superset-bi-agent.external" },
        "contractVersion": { "const": "2.0.0" },
        "runtimeIntents": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            { "const": "status" },
            { "const": "discovery" },
            { "const": "analyze" },
            { "const": "plan" },
            { "const": "preview" },
            { "const": "readback" }
          ],
          "items": false
        }
      }
    },
    "utilityActions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/UtilityAction" }
    },
    "boundaries": { "$ref": "#/$defs/Boundaries" },
    "claimClasses": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "const": "observed-fact" },
        { "const": "computed-fact" },
        { "const": "inferred-candidate" },
        { "const": "human-decision" },
        { "const": "non-claim" }
      ],
      "items": false
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixSchemaVersion", "matrixDigest", "sourceMapDigest"],
      "properties": {
        "matrixSchemaVersion": { "const": "kaleidosphere.portable-companion/compatibility-matrix/v1" },
        "matrixDigest": { "$ref": "#/$defs/Sha256Digest" },
        "sourceMapDigest": { "$ref": "#/$defs/Sha256Digest" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256-canonical-json" },
        "digest": { "$ref": "#/$defs/Sha256Digest" }
      }
    }
  },
  "$defs": {
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "UtilityAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ownerIssue",
        "lifecycle",
        "authority",
        "sideEffect",
        "runtimeIntent",
        "claimClass",
        "dispatch"
      ],
      "properties": {
        "id": {
          "enum": [
            "contract.describe",
            "compatibility.matrix.read",
            "threat-model.read",
            "source-map.verify",
            "doctor.readiness.check",
            "capability.explorer.read",
            "profile-template.validate",
            "receipt-envelope.verify",
            "synthetic-demo.run",
            "evidence-inspector.inspect",
            "cross-harness.verify"
          ]
        },
        "ownerIssue": { "enum": [81, 82, 83, 84, 85, 86, 87, 88] },
        "lifecycle": { "enum": ["foundation", "reserved"] },
        "authority": { "const": "offline-utility-only" },
        "sideEffect": { "enum": ["none", "local-validation-only", "local-fixture-only"] },
        "runtimeIntent": {
          "type": ["string", "null"],
          "enum": ["status", "discovery", "analyze", "plan", "preview", "readback", null]
        },
        "claimClass": {
          "enum": ["observed-fact", "computed-fact", "inferred-candidate", "human-decision", "non-claim"]
        },
        "dispatch": { "const": false }
      }
    },
    "Boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offlinePortableUtilitiesOnly",
        "runtimeDispatchAccepted",
        "arbitraryEndpointDiscoveryAccepted",
        "credentialsAccepted",
        "freeSqlAccepted",
        "rawSourceRowsAccepted",
        "providerPayloadsAccepted",
        "mutationAuthority",
        "deployAuthority",
        "evidenceClaimAuthority",
        "hostedSaasAccepted",
        "remoteMcpAccepted"
      ],
      "properties": {
        "offlinePortableUtilitiesOnly": { "const": true },
        "runtimeDispatchAccepted": { "const": false },
        "arbitraryEndpointDiscoveryAccepted": { "const": false },
        "credentialsAccepted": { "const": false },
        "freeSqlAccepted": { "const": false },
        "rawSourceRowsAccepted": { "const": false },
        "providerPayloadsAccepted": { "const": false },
        "mutationAuthority": { "const": false },
        "deployAuthority": { "const": false },
        "evidenceClaimAuthority": { "const": false },
        "hostedSaasAccepted": { "const": false },
        "remoteMcpAccepted": { "const": false }
      }
    },
    "PortableUtilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contractVersion", "action"],
      "properties": {
        "schemaVersion": { "const": "kaleidosphere.portable-companion/utility-request/v1" },
        "contractVersion": { "const": "1.0.0" },
        "action": {
          "enum": [
            "contract.describe",
            "compatibility.matrix.read",
            "threat-model.read",
            "source-map.verify",
            "doctor.readiness.check",
            "capability.explorer.read",
            "profile-template.validate",
            "receipt-envelope.verify",
            "synthetic-demo.run",
            "evidence-inspector.inspect",
            "cross-harness.verify"
          ]
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    "DoctorReadinessReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contractVersion",
        "action",
        "localUtilityStatus",
        "runtimeStatus",
        "statuses",
        "inspected",
        "checks",
        "guidance",
        "nonClaims",
        "integrity"
      ],
      "properties": {
        "schemaVersion": { "const": "kaleidosphere.portable-companion/doctor-readiness/v1" },
        "contractVersion": { "const": "1.0.0" },
        "action": { "const": "doctor.readiness.check" },
        "localUtilityStatus": {
          "enum": ["READY_LOCAL_UTILITY", "LOCAL_PARTIAL_CONFIGURATION", "LOCAL_BLOCKED"]
        },
        "runtimeStatus": {
          "enum": ["RUNTIME_AVAILABLE", "RUNTIME_UNAVAILABLE", "RUNTIME_PARTIAL"]
        },
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readyLocalUtility", "runtimeAvailable", "analysisSucceeded", "readbackSucceeded"],
          "properties": {
            "readyLocalUtility": { "type": "boolean" },
            "runtimeAvailable": { "type": "boolean" },
            "analysisSucceeded": { "const": false },
            "readbackSucceeded": { "const": false }
          }
        },
        "inspected": { "$ref": "#/$defs/DoctorLocalSnapshot" },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/DoctorCheck" }
        },
        "guidance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/DoctorGuidance" }
        },
        "nonClaims": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 220 }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "sha256-canonical-json" },
            "digest": { "$ref": "#/$defs/Sha256Digest" }
          }
        }
      }
    },
    "DoctorLocalSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostBundle", "runtime", "transport", "capabilityManifest", "configuration"],
      "properties": {
        "hostBundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "supported"],
          "properties": {
            "id": { "const": "kaleidosphere" },
            "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "supported": { "type": "boolean" }
          }
        },
        "runtime": { "$ref": "#/$defs/DoctorStateRuntime" },
        "transport": { "$ref": "#/$defs/DoctorStateTransport" },
        "capabilityManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "observedDigest", "expectedDigest"],
          "properties": {
            "state": { "enum": ["current", "missing", "stale"] },
            "observedDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
            "expectedDigest": { "$ref": "#/$defs/Sha256Digest" }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "missing"],
          "properties": {
            "state": { "enum": ["complete", "partial", "missing"] },
            "missing": {
              "type": "array",
              "items": {
                "enum": ["runtime.identity", "transport.profile", "capability-manifest.file", "host-bundle.support"]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "DoctorStateRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["present", "missing", "partial"] }
      }
    },
    "DoctorStateTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["configured", "missing", "partial"] }
      }
    },
    "DoctorCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
        "status": { "enum": ["PASS", "WARN", "FAIL", "MISSING", "PARTIAL", "STALE", "UNSUPPORTED"] },
        "summary": { "type": "string", "maxLength": 220 }
      }
    },
    "DoctorGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "dispatch"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,80}$" },
        "message": { "type": "string", "maxLength": 220 },
        "dispatch": { "const": false }
      }
    },
    "CapabilityExplorerReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contractVersion",
        "action",
        "manifestBinding",
        "externalApiV2",
        "selectedCapabilityKey",
        "capabilities",
        "boundaries",
        "guidance",
        "nonClaims",
        "integrity"
      ],
      "properties": {
        "schemaVersion": { "const": "kaleidosphere.portable-companion/capability-explorer/v1" },
        "contractVersion": { "const": "1.0.0" },
        "action": { "const": "capability.explorer.read" },
        "manifestBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "manifestVersion", "digest", "sourceCommit"],
          "properties": {
            "schemaVersion": { "const": "kaleidosphere.external/capability-manifest/v1" },
            "manifestVersion": { "const": "1.0.0" },
            "digest": { "$ref": "#/$defs/Sha256Digest" },
            "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          }
        },
        "externalApiV2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractId", "contractVersion", "runtimeIntents"],
          "properties": {
            "contractId": { "const": "superset-bi-agent.external" },
            "contractVersion": { "const": "2.0.0" },
            "runtimeIntents": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "prefixItems": [
                { "const": "status" },
                { "const": "discovery" },
                { "const": "analyze" },
                { "const": "plan" },
                { "const": "preview" },
                { "const": "readback" }
              ],
              "items": false
            }
          }
        },
        "selectedCapabilityKey": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9.-]{1,80}$"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/CapabilityExplorerCapability" }
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtimeDispatchAccepted",
            "arbitraryEndpointDiscoveryAccepted",
            "credentialsAccepted",
            "freeSqlAccepted",
            "rawSourceRowsAccepted",
            "liveEvidenceClaimAcceptedWithoutReceipt"
          ],
          "properties": {
            "runtimeDispatchAccepted": { "const": false },
            "arbitraryEndpointDiscoveryAccepted": { "const": false },
            "credentialsAccepted": { "const": false },
            "freeSqlAccepted": { "const": false },
            "rawSourceRowsAccepted": { "const": false },
            "liveEvidenceClaimAcceptedWithoutReceipt": { "const": false }
          }
        },
        "guidance": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/CapabilityExplorerGuidance" }
        },
        "nonClaims": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 240 }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "sha256-canonical-json" },
            "digest": { "$ref": "#/$defs/Sha256Digest" }
          }
        }
      }
    },
    "CapabilityExplorerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "authority", "sideEffect", "executableInRuntime", "dispatch", "evidenceRequirements", "guidance"],
      "properties": {
        "id": { "enum": ["bi.status.read", "bi.discovery.run", "bi.analysis.run", "bi.graph.adaptive-v1.plan", "bi.preview.create", "bi.readback.read"] },
        "action": { "enum": ["status", "discovery", "analyze", "plan", "preview", "readback"] },
        "authority": { "enum": ["read-only", "local-evidence-write", "source-read-only", "proposal-only"] },
        "sideEffect": { "enum": ["none", "reversible-local-evidence"] },
        "executableInRuntime": { "const": true },
        "dispatch": { "const": false },
        "evidenceRequirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attestationBindingRequired", "resultIntegrityDigestRequired", "executionReceiptRequired"],
          "properties": {
            "attestationBindingRequired": { "const": true },
            "resultIntegrityDigestRequired": { "const": true },
            "executionReceiptRequired": { "const": true }
          }
        },
        "guidance": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/CapabilityExplorerGuidance" }
        }
      }
    },
    "CapabilityExplorerGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "dispatch", "claimClass"],
      "properties": {
        "code": {
          "enum": [
            "READ_BOUNDARY_FIRST",
            "REQUIRE_RECEIPT_BEFORE_EVIDENCE",
            "USE_TRUSTED_RUNTIME_OUTSIDE_UTILITY",
            "KEEP_LOCAL_GUIDANCE_ADVISORY"
          ]
        },
        "message": { "type": "string", "maxLength": 240 },
        "dispatch": { "const": false },
        "claimClass": { "const": "inferred-candidate" }
      }
    }
  }
}
