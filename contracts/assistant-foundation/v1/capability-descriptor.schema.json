{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.chimpmaera.local/assistant-foundation/v1/capability-descriptor.schema.json",
  "title": "CapabilityDescriptor v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "capabilityId", "contractVersion", "risk", "sideEffect", "dataClass", "approval", "cancellation", "idempotency", "readback", "rollback", "concurrency", "enforcement"],
  "properties": {
    "schemaVersion": {"const": "chimpmaera.bi/capability-descriptor/v1"},
    "capabilityId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$"},
    "contractVersion": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "sideEffect": {"enum": ["none", "reversible", "persistent", "external"]},
    "dataClass": {"enum": ["public", "internal", "confidential", "restricted"]},
    "approval": {"type": "string", "minLength": 2},
    "cancellation": {"type": "string", "minLength": 2},
    "idempotency": {"type": "string", "minLength": 2},
    "readback": {"type": "string", "minLength": 2},
    "rollback": {"type": "string", "minLength": 2},
    "concurrency": {"type": "string", "minLength": 2},
    "enforcement": {"type": "string", "minLength": 2}
  }
}
