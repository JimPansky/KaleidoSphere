{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.chimpmaera.local/assistant-foundation/v1/event-envelope.schema.json",
  "title": "EventEnvelope and VersionIdentity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "streamId", "eventType", "channel", "seq", "occurredAt", "correlationId", "causationId", "version", "sensitivity", "payload", "payloadDigest", "ignorable"],
  "properties": {
    "schemaVersion": {"const": "chimpmaera.bi/event-envelope/v1"},
    "eventId": {"$ref": "#/$defs/id"},
    "streamId": {"$ref": "#/$defs/id"},
    "eventType": {"$ref": "#/$defs/id"},
    "channel": {"enum": ["durable", "live"]},
    "seq": {"type": "integer", "minimum": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "correlationId": {"$ref": "#/$defs/id"},
    "causationId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "version": {"$ref": "#/$defs/versionIdentity"},
    "sensitivity": {"$ref": "#/$defs/sensitivity"},
    "payload": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "payloadDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ignorable": {"type": "boolean"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "versionIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "contract", "version", "producer"],
      "properties": {
        "schemaVersion": {"const": "chimpmaera.bi/version-identity/v1"},
        "contract": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
        "producer": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version", "artifactDigest"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"},
            "artifactDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        }
      }
    },
    "sensitivity": {
      "type": "object", "additionalProperties": false,
      "required": ["dataClass", "categories", "redaction"],
      "properties": {
        "dataClass": {"enum": ["public", "internal", "confidential", "restricted"]},
        "categories": {"type": "array", "minItems": 1, "items": {"enum": ["none", "pii"]}, "uniqueItems": true},
        "redaction": {"enum": ["none", "redacted"]}
      }
    }
  }
}
