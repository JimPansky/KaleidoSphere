# Public localhost ports. Do not use the Owner gateway port 18789.
COMPOSE_PROJECT_NAME=chimpmaera-bi-m0
SUPERSET_PORT=18088
AGENT_PORT=18790
BI_UID=1000
BI_GID=1000

# M0 database adapter: MSSQL only.
# fixture is portable and deterministic; live executes the bounded SELECT-only query pack.
BI_SOURCE_MODE=fixture
MSSQL_HOST=host.docker.internal
MSSQL_PORT=1433
MSSQL_DATABASE=CM_BI_FIXTURE
MSSQL_USER=bi_readonly
MSSQL_SCHEMAS=dbo
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
MSSQL_QUERY_TIMEOUT_MS=10000

# Optional OpenAI-compatible intent provider. `stub` is the deterministic offline E2E mode.
LLM_MODE=stub
LLM_BASE_URL=
LLM_MODEL=

# Runtime secrets are files under .secrets/ and .runtime/secrets/ (both gitignored).
# Put a live MSSQL password in .secrets/mssql_password and an optional provider key
# in .secrets/llm_api_key. Never commit either file.
